generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                 String  @id @default(cuid())
  userId             String  @map("user_id")
  type               String
  provider           String
  providerAccountId  String  @map("provider_account_id")
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  passwordHash   String?
  riotAccountId  String?   // For later Riot verification
  primaryRole    Role?
  iconPreference String    @default("NONE")
  accounts       Account[]
  matchupNotes  MatchupNote[]
  riotAccount   RiotAccount?
  matches       Match[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

enum Role {
  TOP
  JGL
  MID
  ADC
  SUPP
}

model MatchupNote {
  id             String   @id @default(cuid())
  userId         String
  role           Role
  myChampion     String
  enemyChampion  String
  mySupport      String?  // Optional for bot lane
  enemySupport   String?  // Optional for bot lane
  prio           String?  // e.g., "Yes", "50/50", "No", "N/A"
  wins           Int      @default(0)
  losses         Int      @default(0)
  notes          String?  @db.Text
  detachLoadouts Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  runePresets    MatchupRunePreset[]
  buildPresets   MatchupBuildPreset[]
  setups         MatchupSetup[]

  @@map("matchup_notes")
}

model MatchupRunePreset {
  id               String   @id @default(cuid())
  matchupNoteId    String
  name             String
  primaryRuneStyle Int?
  subRuneStyle     Int?
  primaryRunes     Int[]    @default([])
  subRunes         Int[]    @default([])
  statShards       Int[]    @default([])
  order            Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  matchupNote MatchupNote    @relation(fields: [matchupNoteId], references: [id], onDelete: Cascade)
  setups      MatchupSetup[]

  @@index([matchupNoteId])
  @@map("matchup_rune_presets")
}

model MatchupBuildPreset {
  id            String   @id @default(cuid())
  matchupNoteId String
  name          String
  starterItems  Int[]    @default([])
  coreItems     Int[]    @default([])
  situational   Int[]    @default([])
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  matchupNote MatchupNote    @relation(fields: [matchupNoteId], references: [id], onDelete: Cascade)
  setups      MatchupSetup[]

  @@index([matchupNoteId])
  @@map("matchup_build_presets")
}

model MatchupSetup {
  id            String   @id @default(cuid())
  matchupNoteId String
  name          String
  note          String?
  runePresetId  String?
  buildPresetId String?
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  matchupNote MatchupNote         @relation(fields: [matchupNoteId], references: [id], onDelete: Cascade)
  runePreset  MatchupRunePreset?  @relation(fields: [runePresetId], references: [id], onDelete: SetNull)
  buildPreset MatchupBuildPreset? @relation(fields: [buildPresetId], references: [id], onDelete: SetNull)

  @@index([matchupNoteId])
  @@map("matchup_setups")
}

model RiotAccount {
  id            String   @id @default(cuid())
  userId        String   @unique
  puuid         String   
  gameName      String
  tagLine       String
  region        String
  profileIconId Int
  summonerId    String?  
  tier          String?
  rank          String?
  leaguePoints  Int?
  lastSyncedAt  DateTime?
  isVerified    Boolean  @default(false)
  
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("riot_accounts")
}

model Match {
  id            String   @id @default(cuid())
  matchId       String   // Riot's internal match ID (e.g. EUW1_12345678)
  userId        String
  puuid         String
  
  // Game Data
  season        Int      @default(16)
  gameCreation  DateTime // When the game started
  gameDuration  Int      // In seconds
  queueId       Int      // 420 for Solo, 440 for Flex
  
  // Player Performance
  championId    Int
  championName  String
  role          String   // TOP, JUNGLE, MIDDLE, BOTTOM, UTILITY
  win           Boolean
  kills         Int
  deaths        Int
  assists       Int
  cs            Int
  goldEarned    Int?
  totalDamageDealtToChampions Int?
  visionScore   Int?
  
  // Lane Opponent Performance (Simplified for now, can be populated if needed)
  enemyChampionName String?
  partnerChampionName String?
  enemyPartnerChampionName String?
  
  // Early Game Stats (at 15 mins)
  csAt15        Int?
  goldAt15      Int?
  laneKills     Int?
  enemyCsAt15   Int?
  enemyGoldAt15 Int?
  enemyLaneKills Int?

  // Items, Summoner Spells & Runes (v1.1)
  items            Int[]   @default([])
  trinketId        Int?
  summoner1Id      Int?
  summoner2Id      Int?
  primaryRuneStyle Int?
  subRuneStyle     Int?
  keystoneId       Int?
  primaryRunes     Int[]   @default([])
  subRunes         Int[]   @default([])
  statShards       Int[]   @default([])
  loadoutSynced    Boolean @default(false)

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([matchId, userId])
  @@index([userId])
  @@index([userId, season])
  @@index([userId, championName])
  @@index([userId, loadoutSynced])
  @@map("matches")
}
